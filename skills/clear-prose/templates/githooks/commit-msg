#!/usr/bin/env bash
# commit-msg - Checks git commit messages using prose_lint.
set -euo pipefail

MSG_FILE="$1"

if command -v prose_lint >/dev/null 2>&1; then
    prose_lint --commit < "$MSG_FILE"
elif [ -f "./.agents/skills/clear-prose/scripts/prose_lint.py" ]; then
    python3 "./.agents/skills/clear-prose/scripts/prose_lint.py" --commit < "$MSG_FILE"
elif [ -f "./prose_lint.py" ]; then
    python3 "./prose_lint.py" --commit < "$MSG_FILE"
elif [ -f "./scripts/prose_lint.py" ]; then
    python3 "./scripts/prose_lint.py" --commit < "$MSG_FILE"
elif [ -f "./utils/prose_lint.py" ]; then
    python3 "./utils/prose_lint.py" --commit < "$MSG_FILE"
elif command -v python3 >/dev/null 2>&1; then
    python3 -m prose_lint --commit < "$MSG_FILE" 2>/dev/null || true
fi
