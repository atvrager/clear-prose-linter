#!/usr/bin/env bash
# commit-msg - Checks git commit messages using prose_lint.
set -euo pipefail

MSG_FILE="$1"

if command -v python3 >/dev/null 2>&1; then
    # Try local prose_lint.py or global installation
    if [ -f "./prose_lint.py" ]; then
        python3 "./prose_lint.py" --commit < "$MSG_FILE"
    elif [ -f "./scripts/prose_lint.py" ]; then
        python3 "./scripts/prose_lint.py" --commit < "$MSG_FILE"
    else
        python3 -m prose_lint --commit < "$MSG_FILE" 2>/dev/null || true
    fi
fi
